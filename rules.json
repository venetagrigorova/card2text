  "PATTERNS": [

    {
      "label": "Date",
      "pattern": [
        {
          "LOWER": {
            "REGEX": "(jänner|januar|feber|februar|märz|april|mai|juni|juli|august|september|oktober|november|dezember|jan|feb|mär|apr|jun|jul|aug|sep|sept|okt|nov|dez)"
          }
        },
        { "IS_DIGIT": true }
      ]
    },

    {
      "label": "Date",
      "pattern": [
        { "IS_DIGIT": true, "LENGTH": 4 }
      ]
    },

    {
      "label": "Film",
      "pattern": [
        { "LOWER": { "REGEX": "rollfilm|film|leicafilm|leica-film|leica" } },
        { "OP": "+", "IS_SPACE": false }
      ]
    },

    {
      "label": "Photographer",
      "pattern": [
        { "LOWER": { "REGEX": "aufn\\.*|aufnahme" } },
        { "IS_ALPHA": true, "OP": "?" },
        { "IS_PUNCT": true, "OP": "?" },
        { "IS_TITLE": true },
        { "IS_TITLE": true, "OP": "?" }
      ]
    },

    {
      "label": "Location",
      "pattern": [
        { "IS_TITLE": true },
        { "IS_TITLE": true }
      ]
    },

    {
      "label": "Location",
      "pattern": [
        { "LOWER": { "REGEX": ".+(dorf|gasse|au|berg|bach|platz|klamm|straße|see)$" } }
      ]
    },

    {
      "label": "Location",
      "pattern": [
        { "LOWER": "klamm" },
        { "LOWER": "bei" },
        { "IS_TITLE": true }
      ]
    }
  ]
}
