{
  "KNOWN_LOCATIONS": [
    "wien", "piesting", "donau", "rax", "horn", "gaming",
    "türnitz", "neusiedlersee", "scheibbs"
  ],

  "PATTERNS": [

    {
      "label": "Date",
      "pattern": [
        {
          "LOWER": {
            "REGEX": "(jänner|januar|feber|februar|märz|april|mai|juni|juli|august|september|oktober|november|dezember|jan|feb|mär|apr|jun|jul|aug|sep|sept|okt|nov|dez)"
          }
        },
        { "IS_PUNCT": true, "OP": "?" },
        { "IS_DIGIT": true }
      ]
    },

    {
      "label": "Date",
      "pattern": [
        {
          "TEXT": {
            "REGEX": "^19[0-9]{2}$"
          }
        }
      ]
    },

    {
      "label": "Film",
      "pattern": [
        { "LOWER": { "REGEX": "(film|rollfilm|leicafilm|leica-film|leica)" } },
        { "OP": "*", "IS_SPACE": false }
      ]
    },

    
    {
      "label": "Photographer",
      "pattern": [
        { "TEXT": { "REGEX": "(?i)aufn[.,]?" } },
        { "TEXT": { "REGEX": "(Dr|Prof)?[.,]?" }, "OP": "?" },
        { "IS_TITLE": true },
        { "IS_TITLE": true, "OP": "?" }
      ]
    },

    {
      "label": "Photographer",
      "pattern": [
        { "TEXT": { "REGEX": "(?i)^aufn.*[A-ZÄÖÜ][a-zäöü]+" } }
      ]
    },

    {
      "label": "Location",
      "pattern": [
        { "IS_TITLE": true, "OP": "+" },
        { "IS_PUNCT": true, "OP": "*" },
        { "IS_TITLE": true, "OP": "*" }
      ]
    },

    {
      "label": "Location",
      "pattern": [
        {
          "LOWER": {
            "REGEX": ".+(dorf|gasse|au|berg|bach|platz|klamm|straße|see|alm|kloster)$"
          }
        }
      ]
    },

    {
      "label": "Location",
      "pattern": [
        { "LOWER": "klamm" },
        { "LOWER": "bei" },
        { "IS_TITLE": true }
      ]
    },

    {
      "label": "Description",
      "pattern": [
        { "IS_ALPHA": true },
        { "IS_ALPHA": true, "OP": "+" }
      ]
    }
  ]
}
